&greenland
    restart_file = "input/GRL-16KM_yelmo_restart.nc"
    out_file     = "hydro.nc"
    t_end        = 1000.0
    dt_step      = 0.5
    dt_out       = 100.0
/

&yhyd
    ! Basal hydrology (fasthydrology). Closure parameters mirror the legacy
    ! &yneff till closure; W_til_max / bkt_till_rate mirror the legacy &ytherm bucket.
    !
    ! NOTE: the group is &yhyd (it was renamed from &fhyd in v0.3). The example
    ! files still carried the old &fhyd name, so their settings were silently
    ! ignored and the schema defaults were used instead.
    method_til       = 1     ! 0=NONE 1=BUCKET
    method_transport = 1     ! 0=NONE 1=K24
    W_til_max        = 2.0   ! [m]   was ytherm.H_w_max
    mask_bc          = 0     ! 0=ZERO 1=IMPOSED 2=MIRROR
    W_til_bc         = 0.0   ! [m]

    ! ---- bucket (bkt_) ----
    bkt_N_closure     = 1      ! -1=EXTERNAL 0=CONST 1=OVERBURDEN 2=MARINE 3=TILL 4=TWO_VALUE
    bkt_till_rate     = 1.0e-3 ! [m/a]  was ytherm.till_rate
    bkt_floating_mode = 1      ! 0=ZERO 1=MARGIN_FILL (legacy saturate floating+margin ring)

    ! ---- closures (no prefix) ----
    const_N         = 1.0e7  ! [Pa] N_CLOSURE_CONST (legacy yneff.const)
    marine_p        = 1.0
    marine_rho_sw   = 1028.0
    till_N0         = 1000.0 ! legacy yneff.N0
    till_delta      = 0.02   ! legacy yneff.delta
    till_e0         = 0.69   ! legacy yneff.e0
    till_Cc         = 0.12   ! legacy yneff.Cc
    two_value_delta = 0.02

    ! ---- k24 (k24_) ----
    ! Defaults mirror the KazmierczakHydroModel constructor keywords in
    ! FastHydrology.jl (src/models/kazmierczak2024/model.jl). The Julia field
    ! each key maps to is named in the trailing comment.

    ! -- mode selectors --
    k24_substrate_type               = 0        ! 0=HARD 1=SOFT 2=MIXED (Fortran-only; builds kappa)
    k24_flux_solver                  = 3        ! psi_out_algorithm: 0=RECURSIVE 1=ITERATIVE 2=TOPOSORT
    k24_toposort_allow_cycles        = False    ! TopologicalPsiOut(allow_cycles=...)
    k24_N_ub_coupled                 = True     ! host velocity iteration re-evaluates N from u_b (hydro_N_from_ub); False = N once per host step
    k24_drainage_mode                = 0        ! 0=BOTH 1=EFFICIENT_ONLY 2=INEFFICIENT_ONLY
    k24_water_thickness_algorithm    = 0        ! 0=DARCY_WEISBACH 1=LAMINAR 2=AREAL_CONDUIT
    k24_gradient_convention          = 0        ! 0=MEAN 1=LOCAL (Darcy-Weisbach / laminar closures only)
    k24_sliding_law                  = 0        ! 0=NONE 1=WEERTMAN 2=POWER_PLASTIC 3=REG_COULOMB

    ! -- physical constants --
    k24_glen_n                       = 3.0      ! n, Glen's flow-law exponent
    k24_latent_heat_water            = 3.34e5   ! L_w [J/kg]
    k24_bed_bump_height              = 0.1      ! h_b, bed obstacle height [m]
    k24_flux_W_exponent              = 1.25     ! alpha = 5/4
    k24_flux_grad_exponent           = 1.5      ! beta  = 3/2
    k24_friction_factor              = 0.1      ! f, Darcy-Weisbach friction factor
    k24_till_factor                  = 1.1      ! F_till
    k24_critical_discharge           = 1.0      ! Q_c [m3/s]
    k24_H0_efficient                 = 0.1      ! H_0 [m]
    k24_conduit_spacing              = 1.0e4    ! l_c, conduit spacing [m]
    k24_coupling_length_kamb86       = 0.0      ! Kamb & Echelmeyer (1986) coupling length / ice thickness; 0 disables the smoothing entirely.
                                                 ! GRL-16KM: the coupling length at the default 10
                                                 ! (10x mean ice thickness) is well under one grid  
                                                 ! cell here, so the smoothing can't be resolved --
                                                 ! see the comment at update_smoothed_potential_gradients
                                                 ! in src/k24.f90 (fesmc/FastHydrology#5).
    k24_water_viscosity              = 5.703855806525211e-11 ! water_viscosity [Pa s] = 1.8e-3 per year

    ! -- clamps. The schema default (input/yelmo_defaults.nml) leaves all four
    !    OFF, matching FastHydrology.jl's constructor. This example sets
    !    KORI-ULB's own values explicitly instead, so it keeps the clamping
    !    behaviour it has always had -- override or delete them to follow the
    !    library default.
    k24_min_pressure_fraction        = 0.02                    ! sigmat
    k24_W_min                        = 1.0e-8                  ! Wmin  [m]
    k24_W_max                        = 0.015                   ! Wmax  [m]
    k24_q_min                        = 0.0                     ! q_min [m2/s]
    k24_q_max                        = 3.168808781402895e-3    ! q_max [m2/s] = 1e5 per year

    ! -- solver configuration --
    k24_fill_iters                   = 10       ! fill_iters
    k24_max_psi_out_calls            = 100000   ! max_psi_out_calls
    k24_dissipation_melt             = True     ! add |q*grad(phi0)|/(L_w*rho_w) to the source
    k24_max_dissipation_iters        = 20       ! max_dissipation_iters
    k24_dissipation_rtol             = 1.0e-12  ! dissipation_rtol
    k24_dissipation_verbose          = True     ! dissipation_verbose
    k24_max_qN_iters                 = 20       ! max_qN_iters        (N-dependent sliding laws)
    k24_qN_rtol                      = 1.0e-8   ! qN_rtol
    k24_qN_verbose                   = True     ! qN_verbose

    ! -- sliding-law parameters. Only the set belonging to k24_sliding_law is
    !    read; C / c_till are mandatory keywords in Julia and default to 0 here,
    !    which makes an unconfigured law a no-op rather than a wrong answer.
    k24_weertman_C                   = 0.0                    ! WeertmanSlidingLaw.C [Pa (s/m)^q]
    k24_weertman_q                   = 0.3333333333333333     ! WeertmanSlidingLaw.q
    k24_power_plastic_c_till         = 0.0                    ! PowerPlasticSlidingLaw.c_till
    k24_power_plastic_q              = 1.0                    ! PowerPlasticSlidingLaw.q
    k24_power_plastic_u0             = 3.168808781402895e-06  ! PowerPlasticSlidingLaw.u0 [m/s] = 100 m/yr
    k24_reg_coulomb_c_till           = 0.0                    ! RegularizedCoulombSlidingLaw.c_till
    k24_reg_coulomb_q                = 0.3333333333333333     ! RegularizedCoulombSlidingLaw.q
    k24_reg_coulomb_u0               = 3.168808781402895e-06  ! RegularizedCoulombSlidingLaw.u0 [m/s] = 100 m/yr
/
